# Base URL of apps/backend. Must be reachable from the device/emulator running Expo, not just your machine:
# - iOS Simulator: http://localhost:4000
# - Android Emulator: http://10.0.2.2:4000
# - Physical device (Expo Go): http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Phase 4 (Social) — optional workout-share photos, uploaded straight from
# the phone to Cloudinary's free tier (the backend never sees the image
# bytes, only the resulting URL). Sharing a photo silently fails without
# these — everything else in the app works fine if you skip this section.
# 1. Create a free account at https://cloudinary.com
# 2. Cloud name is on the dashboard home page.
# 3. Settings → Upload → Upload presets → Add upload preset → Signing Mode: Unsigned.
#    An unsigned preset is safe to ship in the app; it can't read/delete/list
#    anything, only accept new uploads.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
