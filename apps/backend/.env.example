DATABASE_URL="postgresql://user:password@localhost:5432/traktion?schema=public"
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Food tracking (Phase 3) — see DEVELOPMENT_LOG.md for why these two.
# Translates Italian meal descriptions to English before the Nutritionix
# lookup below. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Natural Language for Nutrients endpoint — free tier, sign up at
# https://developer.nutritionix.com/ (App ID + App Key, not a single key).
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=
